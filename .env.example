# Local development only. Create a PostgreSQL database and role first.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=api_metering_platform_dev
DB_USER=api_metering_dev
DB_PASSWORD=replace-with-your-local-database-password
