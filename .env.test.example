# Copy to .env.test and use a dedicated PostgreSQL database ending in _test.
# Replace the password and JWT secret with values specific to your local test setup.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=api_metering_platform_test
DB_USER=api_metering_test
DB_PASSWORD=replace-with-your-local-test-database-password
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-bytes
